NODE_ENV=production
APP_BASE_URL=https://sale-scheduler.tcym.jp
APP_DOMAIN=sale-scheduler.tcym.jp

# Configure in the ColorMe Developer Console for this independent app.
COLORME_CLIENT_ID=
COLORME_CLIENT_SECRET=
COLORME_WEBHOOK_SECRET=
COLORME_APP_KEY=
COLORME_REDIRECT_URI=https://sale-scheduler.tcym.jp/auth/colorme/callback
COLORME_SCOPES=read_products write_products
COLORME_API_BASE_URL=https://api.shop-pro.jp

# Set on the server only. DATABASE_URL must use the internal Docker hostname.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://sale_scheduler:URL_ENCODED_PASSWORD@db:5432/sale_scheduler
TOKEN_ENCRYPTION_KEY=

SESSION_TTL_DAYS=30
API_RATE_LIMIT_REQUESTS=4
API_RATE_LIMIT_WINDOW_MS=10000
VERIFY_MAX_ATTEMPTS=5
VERIFY_BACKOFF_MS=500
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_SECONDS=300
WORKER_ID=sale-scheduler-worker-1

# Public legal/support settings; configure before App Store submission.
OPERATOR_NAME=
SUPPORT_EMAIL=
SUPPORT_URL=
