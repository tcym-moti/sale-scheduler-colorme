[Unit]
Description=Sale Scheduler PostgreSQL encrypted backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/sale-scheduler/backup.env
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=full
PrivateTmp=true
ExecStart=/opt/sale-scheduler-colorme/infra/scripts/backup-postgres.sh
