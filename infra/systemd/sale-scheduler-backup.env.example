# Copy to /etc/sale-scheduler/backup.env on the production host.
# Keep the file root:root with mode 600. Do not commit the populated file.
BACKUP_PROJECT_DIR=/opt/sale-scheduler-colorme
BACKUP_COMPOSE_FILE=/opt/sale-scheduler-colorme/docker-compose.production.yml
BACKUP_APP_ENV_FILE=/opt/sale-scheduler-colorme/.env.production
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=
R2_PREFIX=sale-scheduler/postgres
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
BACKUP_PASSPHRASE_FILE=/etc/sale-scheduler/backup.passphrase
